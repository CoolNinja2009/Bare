# Compiles shaders/*.glsl for every SDL3 GPU backend and writes one C header.
# Run through the bare_shaders target: cmake --build build --target bare_shaders
# Inputs: GLSLC, SHADERCROSS, SRC (shaders directory), OUT, WORK.

file(MAKE_DIRECTORY ${WORK} ${OUT})

function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_VARIABLE out)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Failed: ${ARGN}\n${out}\n${err}")
    endif()
endfunction()

# Appends `file` to `header` as `static const unsigned char name[] = {...};`
function(embed file name header)
    file(READ ${file} hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n    " bytes "${bytes}")
    file(APPEND ${header} "static const unsigned char ${name}[${size}] = {\n    ${bytes}\n};\n\n")
endfunction()

set(header ${OUT}/bare_shaders.h)
file(WRITE ${header} "/* Generated by cmake/compile_shaders.cmake from the .glsl files in shaders/. Do not edit. */\n\n")

# program:stages (pass is vertex-only: the app supplies the fragment shader).
foreach(entry bare:vert,frag glass:vert,frag pass:vert)
    string(REPLACE ":" ";" parts ${entry})
    list(GET parts 0 program)
    list(GET parts 1 stages)
    string(REPLACE "," ";" stages ${stages})
    foreach(stage ${stages})
        if(stage STREQUAL "vert")
            set(define BARE_VERTEX)
            set(sc_stage vertex)
        else()
            set(define BARE_FRAGMENT)
            set(sc_stage fragment)
        endif()
        set(base ${WORK}/${program}_${stage})
        run(${GLSLC} -fshader-stage=${stage} -D${define} -O ${SRC}/${program}.glsl -o ${base}.spv)
        run(${SHADERCROSS} ${base}.spv -s SPIRV -d DXIL -t ${sc_stage} -o ${base}.dxil)
        run(${SHADERCROSS} ${base}.spv -s SPIRV -d MSL -t ${sc_stage} -o ${base}.msl)
        embed(${base}.spv ${program}_${stage}_spirv ${header})
        embed(${base}.dxil ${program}_${stage}_dxil ${header})
        embed(${base}.msl ${program}_${stage}_msl ${header})
    endforeach()
endforeach()

message(STATUS "Wrote ${header}")
