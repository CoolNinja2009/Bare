# Script behind bare_add_shaders(): GLSL fragment shaders -> one C header of
# BareShaderCode values. Inputs: GLSLC, SHADERCROSS, SOURCES (|-separated),
# OUT (header), WORK (scratch directory).

string(REPLACE "|" ";" SOURCES "${SOURCES}")
file(MAKE_DIRECTORY ${WORK})
get_filename_component(out_dir ${OUT} DIRECTORY)
file(MAKE_DIRECTORY ${out_dir})

function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_VARIABLE out)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Failed: ${ARGN}\n${out}\n${err}")
    endif()
endfunction()

function(bytes file var size_var)
    file(READ ${file} hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," b "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n    " b "${b}")
    set(${var} "${b}" PARENT_SCOPE)
    set(${size_var} ${size} PARENT_SCOPE)
endfunction()

set(text "/* Generated by bare_add_shaders() (cmake/bare_shader_header.cmake). Do not edit. */\n")
string(APPEND text "#include \"bare.h\"\n\n")
foreach(src ${SOURCES})
    get_filename_component(stem ${src} NAME_WE)
    string(MAKE_C_IDENTIFIER ${stem} name)
    set(base ${WORK}/${name})
    run(${GLSLC} -fshader-stage=frag -O ${src} -o ${base}.spv)
    run(${SHADERCROSS} ${base}.spv -s SPIRV -d DXIL -t fragment -o ${base}.dxil)
    run(${SHADERCROSS} ${base}.spv -s SPIRV -d MSL -t fragment -o ${base}.msl)
    run(${SHADERCROSS} ${base}.spv -s SPIRV -d JSON -t fragment -o ${base}.json)
    file(READ ${base}.json json)
    string(JSON samplers GET "${json}" samplers)
    string(JSON uniforms GET "${json}" uniform_buffers)
    if(uniforms GREATER 1)
        message(FATAL_ERROR "${src}: at most one uniform block (set = 3, binding = 0)")
    endif()
    foreach(fmt spirv dxil msl)
        if(fmt STREQUAL "spirv")
            set(ext spv)
        else()
            set(ext ${fmt})
        endif()
        bytes(${base}.${ext} b size)
        set(${fmt}_size ${size})
        string(APPEND text "static const unsigned char ${name}_${fmt}[${size}] = {\n    ${b}\n};\n")
    endforeach()
    string(APPEND text "static const BareShaderCode ${name}_shader = {\n"
        "    ${name}_spirv, ${name}_dxil, ${name}_msl, ${spirv_size}, ${dxil_size}, ${msl_size}, "
        "${samplers}, ${uniforms}\n};\n\n")
endforeach()

# Only touch the header when it changed, so unchanged shaders don't rebuild the app.
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE ${OUT} "${text}")
endif()
